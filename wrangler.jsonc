{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checklist",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Page loads are served as static files without running the Worker; only /api/* runs it, plus the installable
    // app's manifest and icons (Stage 13), which are made from Church settings.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/manifest.webmanifest", "/app-icons/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunday-pre-service-checklist",
      // The live database (not a secret).
      "database_id": "965460a0-4dd9-43ad-8671-739c8b578333",
      // Local development (npm run dev, wrangler --local) uses this ID instead, so the local database in
      // .wrangler/state stays the same whatever the live ID is. Never point it at a real database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
