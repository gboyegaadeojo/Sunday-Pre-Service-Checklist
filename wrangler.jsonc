{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunday-pre-service-checklist",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Page loads are served as static files without running the Worker; only /api/* runs it.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunday-pre-service-checklist",
      // Placeholder for local development. Replaced with the real ID in Stage 9.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
