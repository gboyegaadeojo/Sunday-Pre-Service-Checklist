{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunday-pre-service-checklist",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Page loads are served as static files without running the Worker; only /api/* runs it.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunday-pre-service-checklist",
      // The live database (not a secret). Placeholder until it's created in Stage 10.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Local development (npm run dev, wrangler --local) uses this ID instead, so the local database in
      // .wrangler/state stays the same whatever the live ID is. Never point it at a real database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
