{
  "name": "sunday-pre-service-checklist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint --error-on-warnings",
    "typecheck": "wrangler types && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vite build --logLevel warn && vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
